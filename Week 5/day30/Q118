#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;

    cout<<"Enter number of books: ";
    cin>>n;

    int id[n];
    char book[n][50];

    cin.ignore();

    for(int i=0;i<n;i++)
    {
        cout<<"Book ID: ";
        cin>>id[i];

        cin.ignore();

        cout<<"Book Name: ";
        cin.getline(book[i],50);
    }

    cout<<"\nLibrary Records\n";

    for(int i=0;i<n;i++)
    {
        cout<<"ID: "<<id[i]<<endl;
        cout<<"Book: "<<book[i]<<endl<<endl;
    }

    return 0;
}
