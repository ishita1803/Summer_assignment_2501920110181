#include <bits/stdc++.h>
using namespace std;

void display(int roll[],char name[][50],float marks[],int n)
{
    cout<<"\nStudent Records\n";

    for(int i=0;i<n;i++)
    {
        cout<<"Roll: "<<roll[i]<<endl;
        cout<<"Name: "<<name[i]<<endl;
        cout<<"Marks: "<<marks[i]<<endl<<endl;
    }
}

int main()
{
    int n;

    cout<<"Enter number of students: ";
    cin>>n;

    int roll[n];
    char name[n][50];
    float marks[n];

    cin.ignore();

    for(int i=0;i<n;i++)
    {
        cout<<"Roll No: ";
        cin>>roll[i];

        cin.ignore();

        cout<<"Name: ";
        cin.getline(name[i],50);

        cout<<"Marks: ";
        cin>>marks[i];

        cin.ignore();
    }

    display(roll,name,marks,n);

    return 0;
}
