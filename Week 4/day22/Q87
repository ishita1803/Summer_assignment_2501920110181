#include <bits/stdc++.h>
using namespace std;

int main()
{
    char str[100],ch;
    int count=0;

    cout<<"Enter a string: ";
    cin.getline(str,100);

    cout<<"Enter the character: ";
    cin>>ch;

    for(int i=0;i<strlen(str);i++)
    {
        if(str[i]==ch)
            count++;
    }

    cout<<"Frequency of "<<ch<<" = "<<count;

    return 0;
}
