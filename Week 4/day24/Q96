#include <bits/stdc++.h>
using namespace std;

int main()
{
    char str[100];

    cout<<"Enter a string: ";
    cin.getline(str,100);

    for(int i=0;i<strlen(str);i++)
    {
        int flag=0;
        for(int j=0;j<i;j++)
        {
            if(str[i]==str[j])
            {
                flag=1;
                break;
            }
        }

        if(flag==0)
            cout<<str[i];
    }

    return 0;
}
