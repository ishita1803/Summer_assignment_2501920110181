#include <bits/stdc++.h>
using namespace std;

bool cmp(string a,string b)
{
    return a.length()<b.length();
}

int main()
{
    int n;

    cout<<"Enter number of words: ";
    cin>>n;

    string word[n];

    for(int i=0;i<n;i++)
        cin>>word[i];

    sort(word,word+n,cmp);

    cout<<"Words sorted by length:\n";

    for(int i=0;i<n;i++)
        cout<<word[i]<<endl;

    return 0;
}
