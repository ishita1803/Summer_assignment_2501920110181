#include <bits/stdc++.h>
using namespace std;

int main()
{
    char str1[100],str2[100];

    cout<<"Enter first string: ";
    cin.getline(str1,100);

    cout<<"Enter second string: ";
    cin.getline(str2,100);

    cout<<"Common characters: ";

    for(int i=0;i<strlen(str1);i++)
    {
        for(int j=0;j<strlen(str2);j++)
        {
            if(str1[i]==str2[j])
            {
                cout<<str1[i]<<" ";
                break;
            }
        }
    }

    return 0;
}
