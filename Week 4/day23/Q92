#include <bits/stdc++.h>
using namespace std;

int main()
{
    char str[100],maxChar;
    int maxCount=0;

    cout<<"Enter a string: ";
    cin.getline(str,100);

    for(int i=0;i<strlen(str);i++)
    {
        int count=0;
        for(int j=0;j<strlen(str);j++)
        {
            if(str[i]==str[j])
                count++;
        }

        if(count>maxCount)
        {
            maxCount=count;
            maxChar=str[i];
        }
    }

    cout<<"Maximum occurring character = "<<maxChar;

    return 0;
}
