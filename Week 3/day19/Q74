
#include <bits/stdc++.h>
using namespace std;
int main()
{
    int a,b;
    cout<<"Enter the number of rows and columns: ";
    cin>>a>>b;
    int A[a][b], B[a][b],C[a][b];
    for(int i=0; i<a; i++)
    {
        for(int j=0; j<b; j++)
        {
            cout<<"\nEnter A["<<i<<"]["<<j<<"]: ";
            cin>>A[i][j];
        }
    }
    for(int i=0; i<a; i++)
    {
        for(int j=0; j<b; j++)
        {
            cout<<"\nEnter B["<<i<<"]["<<j<<"]: ";
            cin>>B[i][j];
        }
    }
    cout<<"After subtraction:\n";
    
    for(int i=0; i<a; i++)
    {
        for(int j=0; j<b; j++)
        {
            C[i][j]=A[i][j]-B[i][j];
            cout<<C[i][j]<<"\t";
        }
        cout<<"\n";
    }
    return 0;
}
