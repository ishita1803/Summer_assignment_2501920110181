#include <bits/stdc++.h>
using namespace std;
int main()
{
    int n;
    cout<<"Enter the order of matrix: ";
    cin>>n;
    int A[n][n], s=0;
    for(int i=0; i<n; i++)
    {
        for(int j=0; j<n; j++)
        {
            cout<<"\nEnter A["<<i<<"]["<<j<<"]: ";
            cin>>A[i][j];
            if(i==j)
            s=s+A[i][j];
        }
    }
    cout<<"Sum of diagonal elements: "<<s;
    
    return 0;
}
