#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n1, n2;

    cout << "Enter size of first array: ";
    cin >> n1;

    int a[n1];
    for(int i = 0; i < n1; i++)
    {
        cin >> a[i];
    }

    cout << "Enter size of second array: ";
    cin >> n2;

    int b[n2];
    for(int i = 0; i < n2; i++)
    {
        cin >> b[i];
    }

    cout << "Intersection of arrays:\n";

    for(int i = 0; i < n1; i++)
    {
        bool found = false;

        for(int j = 0; j < n2; j++)
        {
            if(a[i] == b[j])
            {
                found = true;
                break;
            }
        }

        if(found)
        {
            bool duplicate = false;

            for(int k = 0; k < i; k++)
            {
                if(a[k] == a[i])
                {
                    duplicate = true;
                    break;
                }
            }

            if(!duplicate)
            {
                cout << a[i] << " ";
            }
        }
    }

    return 0;
}
