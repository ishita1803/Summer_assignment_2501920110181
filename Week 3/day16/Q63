#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n, sum;
    
    cout << "Enter number of elements: ";
    cin >> n;
    
    int a[n];
    
    for(int i = 0; i < n; i++)
    {
        cin >> a[i];
    }
    
    cout << "Enter required sum: ";
    cin >> sum;
    
    bool found = false;
    
    for(int i = 0; i < n; i++)
    {
        for(int j = i + 1; j < n; j++)
        {
            if(a[i] + a[j] == sum)
            {
                cout << "Pair found: " << a[i] << " and " << a[j] << endl;
                found = true;
            }
        }
    }
    
    if(!found)
    {
        cout << "No pair found";
    }
    
    return 0;
}
