#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;
    cout << "Enter the number of elements: ";
    cin >> n;

    int a[n];

    for(int i = 0; i < n; i++)
    {
        cout << "Enter element " << i + 1 << ": ";
        cin >> a[i];
    }

    int temp = a[0];

    for(int i = 0; i < n - 1; i++)
    {
        a[i] = a[i + 1];
    }

    a[n - 1] = temp;

    cout << "\nArray after left rotation:\n";
    for(int i = 0; i < n; i++)
    {
        cout << a[i] << " ";
    }

    return 0;
}
