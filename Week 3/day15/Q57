#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;
    cout << "Enter the total elements in array: ";
    cin >> n;

    int a[n];

    for(int i = 0; i < n; i++)
    {
        cout << "Enter a[" << i << "]: ";
        cin >> a[i];
    }
    cout<<"Reverse Array:\n";
    int s=n-1;
    for(int i=0;i<n;i++)
    {
        cout<<"a["<<i<<"]= "<<a[s]<<"\n";
        s--;
    }

    return 0;
}
