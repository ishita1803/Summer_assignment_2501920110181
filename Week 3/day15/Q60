#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;
    cout << "Enter number of elements: ";
    cin >> n;

    int a[n];

    for(int i = 0; i < n; i++)
    {
        cin >> a[i];
    }

    int j = 0;

    for(int i = 0; i < n; i++)
    {
        if(a[i] != 0)
        {
            swap(a[i], a[j]);
            j++;
        }
    }

    cout << "Array after moving zeroes to end:\n";

    for(int i = 0; i < n; i++)
    {
        cout << a[i] << " ";
    }

    return 0;
}
