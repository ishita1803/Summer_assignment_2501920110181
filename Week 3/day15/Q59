#include <bits/stdc++.h>
using namespace std;

int main()
{
    int n;
    cout << "Enter the number of elements: ";
    cin >> n;

    int a[n];

    for(int i = 0; i < n; i++)
    {
        cout << "Enter element " << i + 1 << ": ";
        cin >> a[i];
    }

    int temp = a[n - 1];

    for(int i = n - 1; i > 0; i--)
    {
        a[i] = a[i - 1];
    }

    a[0] = temp;

    cout << "\nArray after right rotation:\n";
    
    for(int i = 0; i < n; i++)
    {
        cout << a[i] << " ";
    }

    return 0;
}
