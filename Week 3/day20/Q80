#include <bits/stdc++.h>
using namespace std;

int main()
{
    int a,b;
    cout<<"Enter the number of rows and columns: ";
    cin>>a>>b;

    int A[a][b];

    cout<<"Enter the matrix elements:\n";
    for(int i=0;i<a;i++)
    {
        for(int j=0;j<b;j++)
        {
            cin>>A[i][j];
        }
    }

    for(int j=0;j<b;j++)
    {
        int sum=0;
        for(int i=0;i<a;i++)
        {
            sum+=A[i][j];
        }
        cout<<"Sum of Column "<<j+1<<" = "<<sum<<endl;
    }

    return 0;
}
