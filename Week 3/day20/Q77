#include <bits/stdc++.h>
using namespace std;

int main()
{
    int a, b, c, d;

    cout << "Enter rows and columns of first matrix: ";
    cin >> a >> b;

    cout << "Enter rows and columns of second matrix: ";
    cin >> c >> d;

    if (b != c)
    {
        cout << "Multiplication not possible";
        return 0;
    }

    int A[a][b], B[c][d], C[a][d];

    for (int i = 0; i < a; i++)
    {
        for (int j = 0; j < b; j++)
        {
            cout << "A[" << i << "][" << j << "]: ";
            cin >> A[i][j];
        }
    }

    for (int i = 0; i < c; i++)
    {
        for (int j = 0; j < d; j++)
        {
            cout << "B[" << i << "][" << j << "]: ";
            cin >> B[i][j];
        }
    }

    for (int i = 0; i < a; i++)
    {
        for (int j = 0; j < d; j++)
        {
            C[i][j] = 0;
            for (int k = 0; k < b; k++)
            {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    cout << "\nResult matrix:\n";
    for (int i = 0; i < a; i++)
    {
        for (int j = 0; j < d; j++)
        {
            cout << C[i][j] << "\t";
        }
        cout << endl;
    }

    return 0;
}
